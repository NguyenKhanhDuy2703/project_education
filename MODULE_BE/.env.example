PORT=3000
NODE_ENV=production

# JWT Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# bcrypt
SALT_ROUNDS=10

# API prefix
API_PREFIX=api/v1

# Swagger (set false in production if desired)
SWAGGER_ENABLED=true
SWAGGER_TITLE=StudyIT API
SWAGGER_DESCRIPTION=StudyIT — Authentication & Authorization API
SWAGGER_VERSION=1.0
SWAGGER_PREFIX=api/docs

# CORS configuration
# Comma-separated allowed origins, or '*' to allow all
CORS_ORIGIN=https://project-education-red.vercel.app,http://localhost:5173
FRONTEND_URL=https://project-education-red.vercel.app

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://<your-render-app>.onrender.com/api/v1/auth/google/callback

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
