generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  contributor
  user
  userPro
}

enum ContentLifecycleStatus {
  draft
  submitted
  in_review
  changes_requested
  approved
  published
  archived
  rejected
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String?  @unique
  phone          String   @unique
  password       String?
  role           UserRole @default(user)
  isContributor  Boolean  @default(false)
  contributorStatus String @default("NONE")
  avatarUrl      String?
  defaultAddress String?
  isActive       Boolean  @default(true)
  googleId       String?  @unique
  refreshToken   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions     UserSubscription[]
  featureOverrides  UserFeatureOverride[]
  createdAuditLogs  AuditLog[]            @relation("ActorLogs")
  targetedAuditLogs AuditLog[]            @relation("TargetLogs")

  authoredSeries          LabSeries[]              @relation("AuthoredSeries")
  authoredLabs            Lab[]                    @relation("AuthoredLabs")
  groupMemberships        UserGroupMember[]
  submissions             LabSubmission[]
  feedbacks               Feedback[]
  contributorApplications ContributorApplication[] @relation("UserApplications")
  reviewedApplications   ContributorApplication[] @relation("ReviewedApplications")
  sessions                AuthSession[]

  @@map("users")
}

model LabSeries {
  id               String                 @id @default(uuid())
  title            String
  slug             String                 @unique
  category         String                 @default("testing")
  repoUrl          String?
  swaggerUrl       String?
  description      String                 @db.Text
  level            String                 @default("beginner")
  coverEmoji       String?                @default("🧪")
  orderIndex       Int                    @default(0)
  isProOnly        Boolean                @default(false)
  isActive         Boolean                @default(true)
  status           ContentLifecycleStatus @default(draft)
  reviewFeedback   String?                @db.Text
  version          String                 @default("v1.0")
  authorId         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  author           User?                  @relation("AuthoredSeries", fields: [authorId], references: [id], onDelete: SetNull)
  labs             Lab[]

  @@map("lab_series")
}

model Lab {
  id               String                 @id @default(uuid())
  seriesId         String
  title            String
  slug             String                 @unique
  sandboxType      String                 @default("js_worker")
  objective        String?                @db.Text
  instructions     String                 @db.Text
  initialSnippet   String?                @db.Text
  testScript       String?                @db.Text
  solution         String?                @db.Text
  durationMinutes  Int                    @default(20)
  isFreePreview    Boolean                @default(true)
  isProOnly        Boolean                @default(false)
  orderIndex       Int                    @default(0)
  isActive         Boolean                @default(true)
  status           ContentLifecycleStatus @default(draft)
  reviewFeedback   String?                @db.Text
  version          String                 @default("v1.0")
  authorId         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  series           LabSeries              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author           User?                  @relation("AuthoredLabs", fields: [authorId], references: [id], onDelete: SetNull)
  submissions      LabSubmission[]

  @@map("labs")
}

model LabSubmission {
  id              String   @id @default(uuid())
  labId           String
  userId          String
  submittedCode   String   @db.Text
  status          String   @default("passed") // "passed" | "failed"
  executionTimeMs Int      @default(0)
  testLogs        String?  @db.Text
  createdAt       DateTime @default(now())

  lab             Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, labId])
  @@index([labId, createdAt])
  @@map("lab_submissions")
}

// ============================================================================
// Dynamic Authorization, Subscription Plans, IAM Groups & Entitlements
// ============================================================================

enum FeatureCategory {
  lab_execution
  content_access
  ai_assistant
  system_operation
}

enum OverrideEffect {
  ALLOW
  DENY
}

enum BillingCycle {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model Feature {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?         @db.Text
  category    FeatureCategory @default(content_access)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  planFeatures PlanFeature[]
  overrides    UserFeatureOverride[]

  @@map("features")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?          @db.Text
  module          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  planPermissions PlanPermission[]

  @@map("permissions")
}

model SubscriptionPlan {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?      @db.Text
  price        Decimal      @default(0) @db.Decimal(10, 2)
  billingCycle BillingCycle @default(FREE)
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  planFeatures    PlanFeature[]
  subscriptions   UserSubscription[]
  groupPlans      GroupPlan[]
  planPermissions PlanPermission[]

  @@map("subscription_plans")
}

model PlanFeature {
  planId     String
  featureId  String
  limitValue Int?
  createdAt  DateTime @default(now())

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

model PlanPermission {
  planId       String
  permissionId String
  createdAt    DateTime @default(now())

  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([planId, permissionId])
  @@map("plan_permissions")
}

model UserGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    UserGroupMember[]
  groupPlans GroupPlan[]

  @@map("user_groups")
}

model UserGroupMember {
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_group_members")
}

model GroupPlan {
  groupId   String
  planId    String
  createdAt DateTime @default(now())

  group UserGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([groupId, planId])
  @@map("group_plans")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("user_subscriptions")
}

model UserFeatureOverride {
  id        String         @id @default(uuid())
  userId    String
  featureId String
  effect    OverrideEffect
  reason    String         @db.Text
  expiresAt DateTime?
  createdBy String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([userId, effect])
  @@map("user_feature_overrides")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  targetUserId String?
  action       String
  details      Json
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor      User  @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("TargetLogs", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum FeedbackCategory {
  bug
  feature_request
  content_lab
  other
}

model Feedback {
  id        String           @id @default(uuid())
  userId    String?
  email     String?
  category  FeedbackCategory @default(other)
  message   String           @db.Text
  pageUrl   String?
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, createdAt])
  @@map("feedbacks")
}

model ContributorApplication {
  id           String    @id @default(uuid())
  userId       String
  bio          String    @db.Text
  portfolioUrl String?
  sampleTopic  String    @db.Text
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  adminNote    String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("contributor_applications")
}

model AuthSession {
  id                     String    @id @default(uuid())
  userId                 String
  refreshTokenHash       String
  previousTokenHash      String?
  previousTokenExpiresAt DateTime?
  userAgent              String?
  ipAddress              String?
  revokedAt              DateTime?
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([previousTokenHash])
  @@map("auth_sessions")
}
