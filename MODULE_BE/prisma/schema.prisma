generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
  userPro
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String?  @unique
  phone          String   @unique
  password       String?
  role           UserRole @default(user)
  avatarUrl      String?
  defaultAddress String?
  isActive       Boolean  @default(true)
  googleId       String?  @unique
  refreshToken   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model LabSeries {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  category         String   @default("testing")
  repoUrl          String?
  swaggerUrl       String?
  description      String   @db.Text
  level            String   @default("beginner")
  coverEmoji       String?  @default("🧪")
  orderIndex       Int      @default(0)
  isProOnly        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  labs             Lab[]

  @@map("lab_series")
}

model Lab {
  id               String     @id @default(uuid())
  seriesId         String
  title            String
  slug             String     @unique
  sandboxType      String     @default("js_worker")
  objective        String?    @db.Text
  instructions     String     @db.Text
  initialSnippet   String?    @db.Text
  testScript       String?    @db.Text
  solution         String?    @db.Text
  durationMinutes  Int        @default(20)
  isFreePreview    Boolean    @default(true)
  isProOnly        Boolean    @default(false)
  orderIndex       Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  series           LabSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("labs")
}

