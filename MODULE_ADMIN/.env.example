# ==========================================
# MODULE_ADMIN Environment Variables
# ==========================================

# Backend API Endpoint (Bắt buộc khi deploy Production)
# Local development default: http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Tên cổng quản trị (Tùy chọn)
VITE_APP_NAME=StudyIT Admin

# URL của trang Admin (Tùy chọn, dùng cho redirect / metadata)
VITE_SITE_URL=http://localhost:5174
